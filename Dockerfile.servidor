FROM golang:1.23-alpine AS build
WORKDIR /src
COPY go.mod ./
COPY . .
RUN CGO_ENABLED=0 go build -o /bin/servidor ./cmd/servidor

FROM alpine:3.20
COPY --from=build /bin/servidor /bin/servidor
# 9000: clientes TCP (P1). 8080: pares do consorcio (REST, D28).
EXPOSE 9000 8080
ENTRYPOINT ["/bin/servidor"]
